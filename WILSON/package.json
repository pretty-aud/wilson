{
  "name": "wilson",
  "private": true,
  "version": "0.6.3",
  "description": "WILSON - AI-powered creative production & learning platform",
  "toolVersions": {
    "deck-outline-generator": "0.514",
    "otter": "0.3.1",
    "rabbit": "0.1.0"
  },
  "author": "Petal Studios",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:web": "vite build --base=/wilson/ --outDir dist-web",
    "build:vercel": "vite build --base=/wilson/ --outDir dist-vercel/wilson --emptyOutDir",
    "build:vercel:admin": "vite build --mode admin --base=/wilsonadmin/ --outDir dist-vercel/wilsonadmin --emptyOutDir",
    "build:admin": "vite build --mode admin --base=/wilsonadmin/ --outDir dist-web-admin",
    "_comment:dev:admin": "Serves BOTH entries. Open /admin.html for the operator console — / still serves the product app, but built with __WILSON_SURFACE__='admin', so its session key is the operator one. Do not sign in at / under this mode.",
    "dev:admin": "vite --mode admin",
    "preview": "vite preview",
    "preview:web": "node scripts/serve-web.mjs",
    "electron:dev": "npm run build:dev && electron .",
    "electron:start": "electron .",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:publish": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@sentry/electron": "^5.8.0",
    "@supabase/supabase-js": "^2.101.1",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-collaboration": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/y-tiptap": "^3.0.8",
    "cors": "^2.8.6",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-squirrel": "^7.0.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "co.petalstudios.wilson",
    "productName": "WILSON",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/extensions/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/logo.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.petalstudios.co/wilson"
      }
    ]
  }
}
