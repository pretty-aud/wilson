<?xml version="1.0" encoding="utf-8"?>
<!--
  WILSON Gateway Setup.msi (design §11 B; the GW2 brief, item 5). WiX 5.0.2 as a
  dotnet LOCAL tool (gateway/.config/dotnet-tools.json), built by build.ps1.

  What it does:
    * Program Files\WILSON Gateway\ (writable by Administrators and SYSTEM only):
        host\WilsonGatewayHost.exe   the service host (ours, built from source)
        current\node.exe, current\app\…   the gateway (swapped by the updater)
        updater\node.exe, updater\app\…   the updater (replaced only by this MSI)
        wilson-gateway.cmd           the command, on PATH, for administrators
    * two services: WilsonGateway as NT SERVICE\WilsonGateway (a virtual service
      account: no password, no interactive logon, not an administrator; R8), and
      WilsonGatewayUpdater as LocalSystem; both restart on failure
    * ProgramData\WILSON Gateway\ with its ACL set by icacls to SYSTEM,
      Administrators and NT SERVICE\WilsonGateway, inheritance removed; it
      survives a reinstall and an upgrade (enrolment, config, certificates)
    * the office door's firewall rule: TCP 8443, local subnet only, node.exe of
      current\ only. The outside door's rule is NOT added here: the updater adds
      it when the switch is on and removes it when it goes off
    * the token and the cloud's address asked for; the service enrols itself
      at its first start; at the end the addresses the office door uses and the
      certificate's fingerprint are shown
  Unsigned until D14 is decided (GW4): SmartScreen warns; walkthrough 61 says so.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="WILSON Gateway" Manufacturer="Petal Studios" Version="$(var.Version)"
           UpgradeCode="5B7E2C1A-9D44-4E0B-8F6A-2C3D4E5F6A71" Scope="perMachine" Language="1033" Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer WILSON Gateway is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ENROLTOKEN" Hidden="yes" Secure="yes" />
    <Property Id="CLOUDURL" Value="https://rqyriuyldhovirbuievt.supabase.co/functions/v1" Secure="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.Stage)\license.rtf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WILSON Gateway">
        <Directory Id="HostDir" Name="host" />
        <Directory Id="CurrentDir" Name="current">
          <Directory Id="CurrentApp" Name="app" />
        </Directory>
        <Directory Id="UpdaterDir" Name="updater">
          <Directory Id="UpdaterApp" Name="app" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="StateDir" Name="WILSON Gateway" />
    </StandardDirectory>

    <!-- The host and the two services. -->
    <ComponentGroup Id="Services" Directory="HostDir">
      <Component Id="HostExe">
        <File Id="HostExeFile" Source="$(var.Stage)\host\WilsonGatewayHost.exe" KeyPath="yes" />
        <ServiceInstall Id="GatewayService" Name="WilsonGateway" DisplayName="WILSON Gateway"
                        Description="Serves the company's bin clips to the WILSON web app over the office door, and over the outside door while WILSON's switch is on."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="NT SERVICE\WilsonGateway" Arguments="WilsonGateway" Vital="yes">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart" RestartServiceDelayInSeconds="10" ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceInstall Id="UpdaterService" Name="WilsonGatewayUpdater" DisplayName="WILSON Gateway Updater"
                        Description="Swaps in signed WILSON Gateway updates with rollback, and opens or closes the outside door's firewall rule for the gateway."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Arguments="WilsonGatewayUpdater" Vital="yes">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart" RestartServiceDelayInSeconds="10" ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="ControlUpdater" Name="WilsonGatewayUpdater" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <ServiceControl Id="ControlGateway" Name="WilsonGateway" Start="install" Stop="both" Remove="uninstall" Wait="no" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Gateway" Directory="CurrentDir">
      <Component Id="CurrentNode">
        <File Id="CurrentNodeExe" Source="$(var.Stage)\current\node.exe" KeyPath="yes" />
        <fw:FirewallException Id="OfficeDoor" Name="WILSON Gateway office door" Port="8443" Protocol="tcp" Scope="localSubnet" Profile="all" Program="[#CurrentNodeExe]" Description="The office door: browsers on this network only." />
      </Component>
      <Files Directory="CurrentApp" Include="$(var.Stage)\current\app\**" />
    </ComponentGroup>

    <ComponentGroup Id="Updater" Directory="UpdaterDir">
      <Component Id="UpdaterNode">
        <File Id="UpdaterNodeExe" Source="$(var.Stage)\updater\node.exe" KeyPath="yes" />
      </Component>
      <Files Directory="UpdaterApp" Include="$(var.Stage)\updater\app\**" />
    </ComponentGroup>

    <ComponentGroup Id="Command" Directory="INSTALLFOLDER">
      <Component Id="CommandCmd">
        <File Id="CommandCmdFile" Source="$(var.Stage)\wilson-gateway.cmd" KeyPath="yes" />
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
        <RemoveFile Id="RemoveSummary" Name="install-summary.txt" On="uninstall" />
        <RemoveFile Id="RemoveSwapJson" Name="swap.json" On="uninstall" />
        <RemoveFile Id="RemoveStagedArchive" Name="staged.archive" On="uninstall" />
        <RemoveFile Id="RemoveLastManifest" Name="last-manifest.json" On="uninstall" />
      </Component>
      <!-- What the updater makes beside current\: removed with the product. -->
      <Component Id="UpdaterFolders" Guid="6C1D8E2F-3A4B-4C5D-9E6F-7A8B9C0D1E2F">
        <RegistryValue Root="HKLM" Key="Software\Petal Studios\WILSON Gateway" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <util:RemoveFolderEx Id="RemovePrevious" On="uninstall" Property="PREVIOUSDIR" />
        <util:RemoveFolderEx Id="RemoveStaged" On="uninstall" Property="STAGEDDIR" />
        <util:RemoveFolderEx Id="RemoveFailed" On="uninstall" Property="FAILEDDIR" />
        <util:RemoveFolderEx Id="RemoveRollbackTmp" On="uninstall" Property="ROLLBACKTMPDIR" />
      </Component>
    </ComponentGroup>
    <SetProperty Id="PREVIOUSDIR" Value="[INSTALLFOLDER]previous" Before="CostInitialize" Sequence="both" />
    <SetProperty Id="STAGEDDIR" Value="[INSTALLFOLDER]staged" Before="CostInitialize" Sequence="both" />
    <SetProperty Id="FAILEDDIR" Value="[INSTALLFOLDER]failed" Before="CostInitialize" Sequence="both" />
    <SetProperty Id="ROLLBACKTMPDIR" Value="[INSTALLFOLDER]rollback-tmp" Before="CostInitialize" Sequence="both" />

    <ComponentGroup Id="State" Directory="StateDir">
      <Component Id="StateFolder" Guid="2E4F6A8B-0C1D-4E2F-8A3B-5C6D7E8F9A0B" Permanent="yes">
        <CreateFolder />
      </Component>
    </ComponentGroup>

    <!-- Before the two recursive steps below: the state folder must be a real folder (not a junction a local
         user made before a first install, which icacls /T would follow as SYSTEM), hold no link, and hold
         nothing made by another account (a planted config.json would be honoured). It sets the folder's own
         ACL first, so nothing can be added after the check. A failure fails the install (review round 2,
         R2-1, R2-2). -->
    <SetProperty Id="CheckState" Value="&quot;[#CurrentNodeExe]&quot; &quot;[CurrentApp]src\installer.mjs&quot; check-state &quot;[StateDir].&quot;" Before="CheckState" Sequence="execute" />
    <CustomAction Id="CheckState" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no" />

    <!-- The state folder's OWNER first, Administrators on the folder and everything in it: ProgramData lets
         any user create a folder or file there, and one made before the install would stay its maker's, with
         the owner's right to rewrite the ACL set below (review round 1, finding 5). -->
    <SetProperty Id="SetStateOwner" Value="&quot;[System64Folder]icacls.exe&quot; &quot;[StateDir].&quot; /setowner *S-1-5-32-544 /T /C /Q" Before="SetStateOwner" Sequence="execute" />
    <CustomAction Id="SetStateOwner" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no" />

    <!-- The state folder's ACL, once the service's account exists (after InstallServices). -->
    <SetProperty Id="SetStateAcl" Value="&quot;[System64Folder]icacls.exe&quot; &quot;[StateDir].&quot; /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F *S-1-5-32-544:(OI)(CI)F &quot;NT SERVICE\WilsonGateway:(OI)(CI)M&quot; /T /C /Q" Before="SetStateAcl" Sequence="execute" />
    <CustomAction Id="SetStateAcl" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no" />

    <!-- A new pipe key, written as SYSTEM inside the locked folder before the services start: a pipe.key
         planted before the ACL step is replaced, never used. A failure fails the install. -->
    <SetProperty Id="FreshPipeKey" Value="&quot;[#CurrentNodeExe]&quot; &quot;[CurrentApp]src\installer.mjs&quot; fresh-pipe-key &quot;[StateDir].&quot;" Before="FreshPipeKey" Sequence="execute" />
    <CustomAction Id="FreshPipeKey" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no" />

    <!-- The token for the service to enrol itself with at its first start. HideTarget: never in the log. -->
    <SetProperty Id="WriteEnrolFile" Value="&quot;[#CurrentNodeExe]&quot; &quot;[CurrentApp]src\installer.mjs&quot; enrol-file &quot;[StateDir].&quot; &quot;[ENROLTOKEN]&quot; &quot;[CLOUDURL]&quot;" Before="WriteEnrolFile" Sequence="execute" />
    <CustomAction Id="WriteEnrolFile" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64" Execute="deferred" Return="ignore" Impersonate="no" HideTarget="yes" />

    <!-- After the services start: the addresses and the fingerprint, for the last screen. -->
    <SetProperty Id="WriteSummary" Value="&quot;[#CurrentNodeExe]&quot; &quot;[CurrentApp]src\installer.mjs&quot; summary &quot;[StateDir].&quot; &quot;[INSTALLFOLDER]install-summary.txt&quot;" Before="WriteSummary" Sequence="execute" />
    <CustomAction Id="WriteSummary" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64" Execute="deferred" Return="ignore" Impersonate="no" />

    <InstallExecuteSequence>
      <Custom Action="CheckState" After="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="SetStateOwner" After="CheckState" Condition="NOT REMOVE" />
      <Custom Action="SetStateAcl" After="SetStateOwner" Condition="NOT REMOVE" />
      <Custom Action="FreshPipeKey" After="SetStateAcl" Condition="NOT REMOVE" />
      <Custom Action="WriteEnrolFile" After="FreshPipeKey" Condition="NOT REMOVE AND ENROLTOKEN" />
      <Custom Action="WriteSummary" After="StartServices" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="WILSON Gateway" Level="1">
      <ComponentGroupRef Id="Services" />
      <ComponentGroupRef Id="Gateway" />
      <ComponentGroupRef Id="Updater" />
      <ComponentGroupRef Id="Command" />
      <ComponentGroupRef Id="State" />
    </Feature>

    <!-- The two questions, then the summary at the end. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <UI>
      <Dialog Id="EnrolDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="18" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Enrol this gateway with WILSON" />
        <Control Id="Intro" Type="Text" X="15" Y="30" Width="340" Height="40" NoPrefix="yes" Text="Paste the enrolment token WILSON showed you (Settings, Storage, File gateway, Add a gateway). It works once, for 24 hours. The gateway enrols itself when it starts." />
        <Control Id="TokenLabel" Type="Text" X="15" Y="78" Width="340" Height="12" NoPrefix="yes" Text="Enrolment token (wgt_…):" />
        <Control Id="Token" Type="Edit" X="15" Y="92" Width="340" Height="18" Property="ENROLTOKEN" Password="yes" />
        <Control Id="CloudLabel" Type="Text" X="15" Y="120" Width="340" Height="24" NoPrefix="yes" Text="WILSON's cloud address (keep it unless WILSON shows you another one beside the token):" />
        <Control Id="Cloud" Type="Edit" X="15" Y="146" Width="340" Height="18" Property="CLOUDURL" />
        <Control Id="Note" Type="Text" X="15" Y="174" Width="340" Height="36" NoPrefix="yes" Text="The office door listens on this PC's own wired or wireless addresses, never a VPN or virtual adapter; the last screen shows which, and the certificate fingerprint to confirm in WILSON." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <InstallUISequence>
        <Show Dialog="EnrolDlg" After="WelcomeEulaDlg" Condition="NOT Installed AND NOT ENROLTOKEN" />
      </InstallUISequence>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="ShowSummary" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Show the office addresses and the certificate fingerprint" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="ShowSummary" Directory="INSTALLFOLDER" ExeCommand="&quot;[WindowsFolder]notepad.exe&quot; &quot;[INSTALLFOLDER]install-summary.txt&quot;" Return="asyncNoWait" Impersonate="yes" />
  </Package>
</Wix>
