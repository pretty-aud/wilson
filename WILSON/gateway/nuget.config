<?xml version="1.0" encoding="utf-8"?>
<!-- The one package source for the gateway's build tools (WiX 5.0.2 and its extensions), so a
     build resolves the same packages on any computer, whatever its own NuGet settings say. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
