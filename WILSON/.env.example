# =============================================================================
# WILSON environment template — copy to .env.development / .env.staging /
# .env.production and fill in real values. All VITE_* vars are exposed to the
# renderer bundle; never put service_role keys here.
# =============================================================================

# Which Supabase project this env points at. Used for UI labeling and guardrails.
# One of: development | staging | production
WILSON_ENV=development

# Supabase project URL — Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon public key — Settings → API → anon public
# SAFE to ship in the renderer bundle. RLS enforces per-user access.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Sentry DSN — Sentry → Project → Settings → Client Keys (DSN)
# SAFE in the renderer (DSNs are designed to be public).
VITE_SENTRY_DSN=https://YOUR-DSN@oXXXX.ingest.sentry.io/XXXX

# Release/channel tag reported to Sentry. Leave as 'dev' for local work.
VITE_SENTRY_RELEASE=wilson@0.6.3
VITE_SENTRY_ENVIRONMENT=development

# Dev auto sign-in (UI overhaul F1, 2026-09-11). DEV builds only: vite build
# compiles the effect out (src/cloud/auth/LoginScreen.jsx, devAutoLogin.test.js).
# Set all four in .env.local to skip the sign-in screen with a real test account,
# or ONLY `VITE_DEV_AUTOLOGIN=tester` to skip it with no credentials and no session
# (chrome, fonts and kit reviewable; every RLS-gated table empty).
# VITE_DEV_AUTOLOGIN=1
# VITE_DEV_AUTOLOGIN_COMPANY=smoke
# VITE_DEV_AUTOLOGIN_USERNAME=smoke_admin
# VITE_DEV_AUTOLOGIN_PASSWORD=

# Dev fixtures mode (UI overhaul, 2026-09-11). `npm run dev` only: every vite
# build — including `build:dev`, which electron:dev runs — compiles the switch
# out and emits none of src/dev/fixtures (src/dev/devFixtures.test.js).
# Together with VITE_DEV_AUTOLOGIN=tester, fills every table from the fake
# workspace in src/dev/fixtures/data ("Lantern & Ash Pictures", the short film
# "Salt Hours", eight people, 42 tasks, files, scenes, a budget, a rate card,
# notes, one O.T.T.E.R. course). Reads work everywhere; writes stay in memory
# for the session or are refused with a toast. Nothing reaches Supabase.
# The DEV · fixtures badge (top-left) turns it off/on per browser profile
# without editing this file (localStorage 'wilson.dev-fixtures').
# VITE_DEV_FIXTURES=1
